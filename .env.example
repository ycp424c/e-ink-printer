# 可选覆盖项：默认只读访问 cc-switch DB (~/.cc-switch/cc-switch.db) 和
# ~/.codex/auth.json。只有在你想覆盖默认来源时才在 .env 里设置（.env 已被
# gitignore）。进程环境变量优先于本文件。

# DeepSeek API Key（覆盖 cc-switch 的 DeepSeek provider）
# DEEPSEEK_API_KEY=sk-xxxx

# Kimi Coding Plan API Key（覆盖 cc-switch 的 "Kimi For Coding" provider）
# KIMI_API_KEY=sk-kimi-xxxx

# Codex 短期 access token 和账户 ID（不配置时只读 ~/.codex/auth.json）
# CODEX_ACCESS_TOKEN=your-short-lived-access-token
# CODEX_ACCOUNT_ID=your-account-id

# Codex OAuth 凭据文件路径（默认 ~/.codex/auth.json）
# CODEX_AUTH_JSON=~/.codex/auth.json

# 腾讯云 TokenHub 套餐查询（腾讯云 API 3.0，需创建云 API 密钥）：
# 在 https://console.cloud.tencent.com/capi 新建密钥后填入。TokenHub 不读取
# 本机其他配置文件，必须显式配置。
# TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxx
# TENCENTCLOUD_SECRET_KEY=your-secret-key
# 可选：指定要查询的 Token Plan 套餐 ID（不配置时自动选择第一个启用中的套餐）
# TOKENHUB_TEAM_ID=tp-ent-xxxxxxxx
